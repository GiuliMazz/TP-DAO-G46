    <TR><TD BGCOLOR="#eaf6f1"><FONT FACE="DejaVu Sans" COLOR="#405a70" POINT-SIZE="9"><I>abstracta / interfaz</I></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="6"><FONT FACE="DejaVu Sans" POINT-SIZE="10">+ validar(solicitud, ejemplar)<BR ALIGN="LEFT"/>+ calcularVencimiento(fecha): date<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>]
	PoliticaLocal [label=<<TABLE BORDER="1" COLOR="#246d5d" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#eaf6f1">
