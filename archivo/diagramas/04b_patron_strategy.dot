	ServicioPrestamos -> PoliticaPrestamo [label=utiliza arrowhead=vee dir=forward headlabel=1 labelangle=25 labeldistance=1.8 style=solid taillabel=1]
	PoliticaLocal -> PoliticaPrestamo [label=implementa arrowhead=empty dir=forward labelangle=25 labeldistance=1.8 style=dashed]
