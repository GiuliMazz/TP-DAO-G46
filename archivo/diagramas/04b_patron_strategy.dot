    <TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="6"><FONT FACE="DejaVu Sans" POINT-SIZE="10">+ validar(solicitud, ejemplar)<BR ALIGN="LEFT"/>+ calcularVencimiento(fecha): date<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>]
