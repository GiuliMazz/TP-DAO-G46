digraph Bibliografia {
	bgcolor=white fontname="DejaVu Sans" nodesep=.39 outputorder=edgesfirst pad=0.34 rankdir=LR ranksep=.8 splines=polyline
	node [fontname="DejaVu Sans" shape=plaintext]
	edge [arrowhead=none arrowsize=.65 color="#6b8094" fontname="DejaVu Sans" fontsize=10 labelfontcolor="#52677b" penwidth=1.25]
	Obra [label=<<TABLE BORDER="1" COLOR="#153c63" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#eef5fb">
    <TR><TD BGCOLOR="#153c63" CELLPADDING="7"><FONT FACE="DejaVu Sans" COLOR="white" POINT-SIZE="13"><B>Obra</B></FONT></TD></TR>
    <TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="6"><FONT FACE="DejaVu Sans" POINT-SIZE="10">- id: UUID<BR ALIGN="LEFT"/>- idOpenLibrary: str {unique}<BR ALIGN="LEFT"/>- tituloOriginal: str<BR ALIGN="LEFT"/>- descripcionOriginal: str?<BR ALIGN="LEFT"/>- tipoMaterial: TipoMaterial<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>]
	Edicion [label=<<TABLE BORDER="1" COLOR="#153c63" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#eef5fb">
    <TR><TD BGCOLOR="#153c63" CELLPADDING="7"><FONT FACE="DejaVu Sans" COLOR="white" POINT-SIZE="13"><B>Edicion</B></FONT></TD></TR>
    <TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="6"><FONT FACE="DejaVu Sans" POINT-SIZE="10">- id: UUID<BR ALIGN="LEFT"/>- idOpenLibrary: str {unique}<BR ALIGN="LEFT"/>- titulo: str<BR ALIGN="LEFT"/>- idioma: str<BR ALIGN="LEFT"/>- isbn13: str?; isbn10: str?<BR ALIGN="LEFT"/>- editorial: str?<BR ALIGN="LEFT"/>- descripcionEs: str?<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>]
	Autor [label=<<TABLE BORDER="1" COLOR="#153c63" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#eef5fb">
    <TR><TD BGCOLOR="#153c63" CELLPADDING="7"><FONT FACE="DejaVu Sans" COLOR="white" POINT-SIZE="13"><B>Autor</B></FONT></TD></TR>
    <TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="6"><FONT FACE="DejaVu Sans" POINT-SIZE="10">- id: UUID<BR ALIGN="LEFT"/>- idOpenLibrary: str {unique}?<BR ALIGN="LEFT"/>- nombre: str<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>]
	Genero [label=<<TABLE BORDER="1" COLOR="#153c63" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#eef5fb">
    <TR><TD BGCOLOR="#153c63" CELLPADDING="7"><FONT FACE="DejaVu Sans" COLOR="white" POINT-SIZE="13"><B>Genero</B></FONT></TD></TR>
    <TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="6"><FONT FACE="DejaVu Sans" POINT-SIZE="10">- id: UUID<BR ALIGN="LEFT"/>- nombre: str {unique}<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>]
	Etiqueta [label=<<TABLE BORDER="1" COLOR="#153c63" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#eef5fb">
    <TR><TD BGCOLOR="#153c63" CELLPADDING="7"><FONT FACE="DejaVu Sans" COLOR="white" POINT-SIZE="13"><B>Etiqueta</B></FONT></TD></TR>
    <TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="6"><FONT FACE="DejaVu Sans" POINT-SIZE="10">- id: UUID<BR ALIGN="LEFT"/>- nombre: str {unique}<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>]
	ObraGenero [label=<<TABLE BORDER="1" COLOR="#664983" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#f5f0fb">
    <TR><TD BGCOLOR="#664983" CELLPADDING="7"><FONT FACE="DejaVu Sans" COLOR="white" POINT-SIZE="13"><B>ObraGenero</B></FONT></TD></TR>
    <TR><TD BGCOLOR="#f5f0fb"><FONT FACE="DejaVu Sans" COLOR="#405a70" POINT-SIZE="9"><I>asociacion con atributos</I></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="6"><FONT FACE="DejaVu Sans" POINT-SIZE="10">- estadoClasificacion: EstadoClasificacion<BR ALIGN="LEFT"/>- fechaRevision: datetime?<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>]
	ObraEtiqueta [label=<<TABLE BORDER="1" COLOR="#664983" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#f5f0fb">
    <TR><TD BGCOLOR="#664983" CELLPADDING="7"><FONT FACE="DejaVu Sans" COLOR="white" POINT-SIZE="13"><B>ObraEtiqueta</B></FONT></TD></TR>
    <TR><TD BGCOLOR="#f5f0fb"><FONT FACE="DejaVu Sans" COLOR="#405a70" POINT-SIZE="9"><I>asociacion con atributos</I></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="6"><FONT FACE="DejaVu Sans" POINT-SIZE="10">- estadoClasificacion: EstadoClasificacion<BR ALIGN="LEFT"/>- fechaRevision: datetime?<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>]
	Obra -> Edicion [label=tiene headlabel="0..*" labelangle=25 labeldistance=1.8 style=solid taillabel=1]
	Obra -> Autor [label="escrita por" headlabel="1..*" labelangle=25 labeldistance=1.8 style=solid taillabel="0..*"]
	Obra -> ObraGenero [label=clasificacion headlabel="0..*" labelangle=25 labeldistance=1.8 style=solid taillabel=1]
	ObraGenero -> Genero [label=genero headlabel=1 labelangle=25 labeldistance=1.8 style=solid taillabel="0..*"]
	Obra -> ObraEtiqueta [label=etiquetado headlabel="0..*" labelangle=25 labeldistance=1.8 style=solid taillabel=1]
	ObraEtiqueta -> Etiqueta [label=etiqueta headlabel=1 labelangle=25 labeldistance=1.8 style=solid taillabel="0..*"]
}
